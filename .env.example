# Postgres connection (Neon / Supabase / Vercel Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD="change-me-please"
# Optional direct (non-pooled) URL used by `prisma migrate`; falls back to DATABASE_URL
# DIRECT_URL=""
# Tests also use DATABASE_URL and wipe its tables, so they only run when it is a local database (or ALLOW_REMOTE_TEST_DB=1)
# Optional: `npm run db:seed` creates/updates this teacher account
# SEED_TEACHER_EMAIL=""
# SEED_TEACHER_PASSWORD=""
