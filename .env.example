# Postgres connection (Neon / Supabase / Vercel Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Optional direct (non-pooled) URL used by `prisma migrate`; falls back to DATABASE_URL
# DIRECT_URL=""
# Used only by the tests (a throw-away database - its tables are wiped)
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/algorithm_chart_test"
# Optional: `npm run db:seed` creates/updates this teacher account
# SEED_TEACHER_EMAIL=""
# SEED_TEACHER_PASSWORD=""
